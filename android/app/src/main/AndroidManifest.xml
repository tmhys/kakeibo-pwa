<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 家計簿の画面（GitHub Pages）と gas（script.google.com）に通信する -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
                ブラウザのリンクからこのアプリを開くための口。
                マイツール（tmhys/my-apps）のポータルが kakeibo://open を叩く。

                BROWSABLE が要るのは、Chrome が intent:// を発射するときに
                BROWSABLE を必ず足すため。Android は付いた全カテゴリを宣言して
                いるアクティビティしか起動しないので、MAIN / LAUNCHER だけだと
                一致せず、ブラウザ側のフォールバック（ウェブ版）に落ちてしまう。

                独自スキームにしているのは、https をそのまま受けるには
                Digital Asset Links が要り、tmhys.github.io は共用ドメインで
                置きにくいため。渡ってくる URL は使わない（MainActivity は
                いつもどおり appUrl を開く）。入口を増やすだけ。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="kakeibo" />
            </intent-filter>
        </activity>
    </application>
</manifest>
